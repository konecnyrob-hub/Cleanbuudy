# ============================================================
# SHOPIFY STOREFRONT API — zkopírujte jako `.env.local` a doplňte.
# Návod krok za krokem: SHOPIFY_SETUP.md
# ============================================================

# --- POVINNÉ ---

# Doména obchodu (vždy *.myshopify.com, ne vlastní doména)
SHOPIFY_STORE_DOMAIN=muj-obchod.myshopify.com

# GID varianty produktu, kterou prodáváte tlačítkem „Koupit"
SHOPIFY_VARIANT_ID=gid://shopify/ProductVariant/1234567890

# --- VOLITELNÉ ---

# Verze API — výchozí 2026-07 (nejnovější stabilní)
# SHOPIFY_API_VERSION=2026-07

# Košík/checkout funguje BEZ tokenu (tokenless přístup, 2026).
# Token doplňte jen pro vyšší limity nebo přístup k tagům/metafieldům:
#   - privátní token (server, doporučeno) → má přednost
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
#   - nebo veřejný token
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (volitelné) Veřejná URL webu pro Open Graph / sdílení
# NEXT_PUBLIC_SITE_URL=https://www.cleaner.cz
